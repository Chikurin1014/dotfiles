[Unit]
Description=SSH key agent
# On WSL, ssh-agent service of Windows is used via wsl2-ssh-agent instead
ConditionVirtualization=!wsl

[Service]
Type=simple
# Resolve ssh-agent from PATH since it is not in /usr/bin on NixOS
ExecStart=/usr/bin/env ssh-agent -D -a %t/ssh-agent.socket

[Install]
WantedBy=default.target
