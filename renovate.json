{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "nix": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "The dependency graphs of npm packages generated by `mise lock` are updated with mise.lock",
      "matchFileNames": ["**/.mise/locks/**"],
      "enabled": false
    },
    {
      "description": "Update the flake inputs weekly in one pull request",
      "matchManagers": ["nix"],
      "groupName": "flake inputs",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Update the submodules (nvim-config) weekly",
      "matchManagers": ["git-submodules"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Update GitHub Actions monthly",
      "matchManagers": ["github-actions"],
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "description": "Update the tools of mise weekly in one pull request, after their assets for every platform are likely uploaded",
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "minimumReleaseAge": "3 days",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Keep Node.js on LTS (even major versions)",
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "allowedVersions": "/^\\d*[02468]\\./"
    },
    {
      "description": "Keep the base image of the Docker container on Ubuntu LTS",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ubuntu"],
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    }
  ]
}
